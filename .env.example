COMPOSIO_API_KEY=your_composio_key_here

# ── Research provider: Gemini (free tier, agentic) ──────────────────────────
GOOGLE_API_KEY=your_google_ai_studio_key_here
# Current stable Flash model for autonomous agents. Confirm in Google AI Studio.
# Free tier has RPM + RPD limits — use workers=1 initially.
GEMINI_RESEARCH_MODEL=gemini-3.8-flash

# ── Verification provider: Claude (direct Anthropic Messages API) ────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
# Uses composio_anthropic / AnthropicProvider with an explicit tool-calling loop.
# Low-volume (3 smoke / 12 full) — deterministic control, no Claude CLI needed.
# Confirm the exact model string in your Anthropic console.
CLAUDE_VERIFY_MODEL=claude-sonnet-5

# ── Pipeline settings ────────────────────────────────────────────────────────
COMPOSIO_USER_ID=ai-product-ops-researcher
# Default 1 worker for Gemini free tier; increase only after first 10-20 apps stable.
WORKERS=1
BATCH_SIZE=5
